# migration fixtures are the exceptions
*.pgn.zst
*.jsonl.zst
*.db
*.db-journal
*.db-wal
*.db-shm
!pipeline/tests/sample/*.pgn.zst
!pipeline/tests/sample/eval/*.jsonl.zst
!**/tests/fixtures/*.db

