# Every test carries its labels (docs/reference/testing-tools.md, **Tests**): the ctest test
# "labels" (labels cmake;unit), run as
#   cmake -DCTEST=<ctest> -DBUILD_DIR=<build directory> -P cmake/labels_check.cmake
# It lists the build's tests with ctest --show-only=json-v1 and fails, naming them, on any test
# without exactly one module label (core, pipeline, cli, app or cmake) and one kind label (unit,
# property, engine, ui or bench). It also fails when no test with [ and ] in its name is listed,
# so the case chesscoach_add_test's labels script must handle, a Catch2 name with brackets, stays
# covered (core_tier_test has one).
cmake_minimum_required(VERSION 3.28)

if(NOT CTEST OR NOT BUILD_DIR)
  message(FATAL_ERROR "usage: cmake -DCTEST=<ctest> -DBUILD_DIR=<dir> -P cmake/labels_check.cmake")
endif()

execute_process(COMMAND "${CTEST}" --test-dir "${BUILD_DIR}" --show-only=json-v1
                OUTPUT_VARIABLE listing RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "ctest --show-only failed (${result}): ${errors}")
endif()

set(modules core pipeline cli app cmake)
set(kinds unit property engine ui bench)
string(JSON tests GET "${listing}" tests)
string(JSON count LENGTH "${tests}")
set(unlabelled "")
set(bracketed 0)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON test GET "${tests}" ${index})
    string(JSON name GET "${test}" name)
    set(labels "")
    string(JSON properties ERROR_VARIABLE no_properties GET "${test}" properties)
    if(NOT no_properties)
      string(JSON property_count LENGTH "${properties}")
      math(EXPR last_property "${property_count} - 1")
      foreach(property_index RANGE ${last_property})
        string(JSON property_name GET "${properties}" ${property_index} name)
        if(property_name STREQUAL "LABELS")
          string(JSON label_count LENGTH "${properties}" ${property_index} value)
          math(EXPR last_label "${label_count} - 1")
          foreach(label_index RANGE ${last_label})
            string(JSON label GET "${properties}" ${property_index} value ${label_index})
            list(APPEND labels "${label}")
          endforeach()
        endif()
      endforeach()
    endif()
    set(module_labels 0)
    set(kind_labels 0)
    foreach(label IN LISTS labels)
      if(label IN_LIST modules)
        math(EXPR module_labels "${module_labels} + 1")
      elseif(label IN_LIST kinds)
        math(EXPR kind_labels "${kind_labels} + 1")
      endif()
    endforeach()
    if(NOT module_labels EQUAL 1 OR NOT kind_labels EQUAL 1)
      string(APPEND unlabelled "\n  ${name}: labels '${labels}'")
    endif()
    string(FIND "${name}" "[" open_at)
    string(FIND "${name}" "]" close_at)
    if(open_at GREATER_EQUAL 0 AND close_at GREATER_EQUAL 0)
      math(EXPR bracketed "${bracketed} + 1")
    endif()
  endforeach()
endif()

if(unlabelled)
  message(FATAL_ERROR "tests without one module and one kind label:${unlabelled}")
endif()
if(bracketed EQUAL 0)
  message(FATAL_ERROR "no test has [ and ] in its name, so their labels go unchecked")
endif()
message(STATUS "labels: ${count} tests labelled, ${bracketed} with brackets in their names")
